  <script>
    const canvas = document.getElementById("mainChart");
    const ctx = canvas.getContext("2d");

    function resizeCanvas() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * window.devicePixelRatio;
      canvas.height = rect.height * window.devicePixelRatio;
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }
    window.addEventListener("resize", drawStaticChart);

    function drawStaticChart() {
      resizeCanvas();
      const rect = canvas.getBoundingClientRect();
      const w = rect.width;
      const h = rect.height;

      ctx.clearRect(0, 0, w, h);

      // Grid de Fundo
      ctx.strokeStyle = "rgba(30, 41, 59, 0.4)";
      ctx.lineWidth = 1;
      for (let y = 40; y < h; y += 50) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }

      // Desenhar Velas Simuladas com base nos dados reais conhecidos ($85,377)
      const points = 35;
      const step = w / points;
      let currentY = h * 0.5;

      ctx.lineWidth = 2;
      for (let i = 0; i < points; i++) {
        const x = i * step + 15;
        // Alargamento (Megaphone simulation)
        const envelope = Math.sin(i * 0.35) * (i * 2.2);
        const open = currentY + envelope + (Math.random() - 0.5) * 15;
        const close = open + (Math.random() - 0.48) * 25;
        const high = Math.min(open, close) - Math.random() * 12 - 5;
        const low = Math.max(open, close) + Math.random() * 12 + 5;

        const isUp = close <= open; // Invertido para o canvas screen coordinate
        ctx.strokeStyle = isUp ? "#00f5a0" : "#f43f5e";
        ctx.fillStyle = isUp ? "rgba(0, 245, 160, 0.8)" : "rgba(244, 63, 94, 0.8)";

        // Wick
        ctx.beginPath();
        ctx.moveTo(x, high);
        ctx.lineTo(x, low);
        ctx.stroke();

        // Body
        ctx.fillRect(x - 3, Math.min(open, close), 6, Math.max(2, Math.abs(close - open)));
        currentY = close;
      }

      // Linhas de Tendência Convergentes/Divergentes (Megaphone / Broadening)
      ctx.strokeStyle = "#00f2fe";
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(15, h * 0.7);
      ctx.lineTo(w - 15, h * 0.2); // Top slope up
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(15, h * 0.4);
      ctx.lineTo(w - 15, h * 0.85); // Bottom slope down
      ctx.stroke();
      ctx.restore();
    }

    async function runEngineAnalysis() {
