      document.getElementById('metric-atr').textContent = "$110.71";
      
      document.getElementById('slope-low').textContent = "-0.2749";
      document.getElementById('slope-high').textContent = "+0.5568";

      document.getElementById('oracle-verdict-text').innerHTML = `
        <strong>VEREDITO:</strong> Consolidação / Alargamento Lateral (Megaphone / Broadening Formation) 🟡<br>
        <em>Análise Vetorial:</em> A inclinação dos fundos (-0.2749) e dos topos (+0.5568) indica divergência estrutural e volatilidade em expansão. O modelo TRADER confirmou que o estado latente L2 está estável (0.0028), isolando o ruído de 15m.
      `;

      document.getElementById('rec-stop').textContent = "$85,211.72";
      document.getElementById('rec-tp').textContent = "$85,710.00";

      drawStaticChart();
    }

    // Executar ao carregar
    drawStaticChart();
